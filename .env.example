# =============================================================================
# .env.example — Runtime environment variable contract
#
# Copy to .env and fill in values for your environment.
# All variables are optional when running with local defaults.
# =============================================================================


# -----------------------------------------------------------------------------
# Runtime bind (Gradio server)
# -----------------------------------------------------------------------------

# Address the Gradio server binds to.
# Use "0.0.0.0" in container context (required to be reachable from outside).
# Use "127.0.0.1" for local-only development.
GRADIO_SERVER_NAME=0.0.0.0

# TCP port the Gradio server listens on.
GRADIO_SERVER_PORT=7860


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Generation backend
# -----------------------------------------------------------------------------

# Base URL for the Ollama daemon.
# Set to wherever Ollama is running: local process, Docker network, or remote.
# Topology (sidecar, co-located, remote) is not prescribed here.
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model tag used for answer synthesis.
GENERATION_MODEL=qwen3:8b


# -----------------------------------------------------------------------------
# Embedding model
# -----------------------------------------------------------------------------

# HuggingFace model ID for chunk embedding (local pipeline).
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B


# -----------------------------------------------------------------------------
# Storage backend
# -----------------------------------------------------------------------------

# "local"      — write artifacts to disk (default)
# "azure_blob" — write artifacts to Azure Blob Storage
STORAGE_BACKEND=local

# Required when STORAGE_BACKEND=azure_blob:
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER_ARTIFACTS=documents-processed
AZURE_STORAGE_CONTAINER_MANIFESTS=documents-processed


# -----------------------------------------------------------------------------
# OCR backend
# -----------------------------------------------------------------------------

# "local"    — Docling/RapidOCR (default)
# "azure_di" — Azure AI Document Intelligence prebuilt-read
OCR_BACKEND=local

# Required when OCR_BACKEND=azure_di:
AZURE_DI_ENDPOINT=


# -----------------------------------------------------------------------------
# Search backend
# -----------------------------------------------------------------------------

# "local"         — LlamaIndex/ChromaDB/BM25 hybrid (default)
# "azure_search"  — Azure AI Search
SEARCH_BACKEND=local

# Required when SEARCH_BACKEND=azure_search:
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=document-intelligence


# -----------------------------------------------------------------------------
# Azure identity (applies to all azure_* backends)
# -----------------------------------------------------------------------------

# DefaultAzureCredential is used automatically when any Azure backend is
# active.  In local dev, run `az login`.  In a container on Azure, assign
# a managed identity to the compute resource — no credentials needed here.
#
# For service-principal auth (CI / non-Azure hosts), set:
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=
